# Skopiuj ten plik jako .env i uzupełnij. Pliku .env nie wysyłaj nikomu ani nie wrzucaj do repozytorium.

# Token bota: Developer Portal -> Twoja aplikacja -> Bot -> Reset Token (bez cudzysłowów).
DISCORD_TOKEN=
# Numer serwera: Discord -> Ustawienia -> Zaawansowane -> Tryb dewelopera, potem prawy przycisk na ikonie serwera -> Kopiuj ID.
GUILD_ID=

# Forum z zadaniami (nazwa kanału albo jego numer). Domyślnie szuka forum o nazwie "artykuly".
FORUM_NAME=artykuly
#FORUM_ID=

# Odczyt osób i terminów z linii "Odpowiedzialny:" i "Termin:" w postach założonych ręcznie lub przez starszą wersję bota.
# Wymaga włączenia "Message Content Intent" w Developer Portal (Bot -> Privileged Gateway Intents).
# Karty, przyciski, formularze i żywa tablica działają także bez tego.
MESSAGE_CONTENT=0

# Codzienne podsumowanie na kanale tekstowym (nazwa albo numer), od godziny DIGEST_HOUR, w dni 1-5 (1 = poniedziałek).
DIGEST_ENABLED=1
DIGEST_CHANNEL_NAME=ogolne
# Numer kanału (zamiast nazwy). Taki kanał bot wykorzystuje bez sprawdzania, kto go widzi: wybierz kanał redakcji.
#DIGEST_CHANNEL_ID=
DIGEST_HOUR=9
DIGEST_WEEKDAYS=1,2,3,4,5
# 1 = oznacz osoby, których zadania są po terminie lub z bliskim terminem
DIGEST_PING=0
TIMEZONE=Europe/Warsaw

# 0 = nie rejestruj komend przy starcie (zwykle zostaw 1).
#REGISTER_COMMANDS=1

# Po ilu milisekundach od zmiany bot odświeża żywą tablicę (zmiany z tego czasu trafiają do jednej aktualizacji).
#BOARD_DEBOUNCE_MS=2000

# ---------------------------------------------------------------------------------------------------------------
# Tablica z przeciąganiem kart (strona w przeglądarce i Activity w Discordzie). Cały ten blok jest opcjonalny:
# bez DISCORD_CLIENT_SECRET bot działa jak dotąd (karty, przyciski, żywa tablica), a strona się nie uruchamia.
# Kroki (Developer Portal, adres, tunel): README, rozdział "Tablica z przeciąganiem".
# ---------------------------------------------------------------------------------------------------------------

# Sekret aplikacji: Developer Portal -> OAuth2 -> Client Secret -> Reset Secret. To NIE jest token bota. Nikomu go nie wysyłaj.
DISCORD_CLIENT_SECRET=
# Publiczny adres strony, pod którym otwiera ją przeglądarka, bez ukośnika na końcu i bez ścieżki, np. https://tablica.gameby.pl
# Musi być https (wyjątek: http://localhost albo http://127.0.0.1 do prób na własnym komputerze).
# Ten sam adres wpisz w Developer Portal: OAuth2 -> Redirects jako <PUBLIC_URL>/auth/callback.
PUBLIC_URL=

# Na którym porcie komputera ma stać strona (docker compose wystawia ją tylko na 127.0.0.1). Domyślnie 8080.
#HOST_PORT=8080
# Po ilu godzinach logowanie wygasa (1-720, domyślnie 168 czyli tydzień). Restart bota i tak wylogowuje wszystkich.
#SESSION_HOURS=168

# 1 = adres klienta (do limitów zapytań) bierz z nagłówków serwera pośredniczącego, czyli tunelu Cloudflare. Z docker-compose.yml to jest
# bezpieczne: port strony jest wystawiony tylko na 127.0.0.1, więc dotrzeć do niego może wyłącznie ten komputer i tunel.
# Bez tego (0) cały ruch z tunelu wygląda jak jedna osoba i jeden napastnik mógłby zablokować logowanie całej redakcji.
# Ustaw 0 tylko wtedy, gdy uruchamiasz bota bez tunelu i bez serwera pośredniczącego, a jego port jest dostępny z innych komputerów.
TRUST_PROXY=1
# Co stoi przed botem (ma znaczenie tylko przy TRUST_PROXY=1): cloudflare = tunel Cloudflare z docker-compose.yml (domyślnie),
# railway = hosting Railway (adres klienta z nagłówka X-Real-IP, który brama Railway sama nadpisuje). Nie ustawiaj railway przy tunelu i odwrotnie:
# nagłówek drugiej usługi mógłby wtedy podrobić każdy, kto zna adres strony.
#PROXY_TYPE=cloudflare
# 1 = na żywej tablicy pojawia się przycisk "Tablica z przeciąganiem", który uruchamia stronę jako Activity w Discordzie.
# Wymaga włączonych Activities w Developer Portal. Wersja bez weryfikacji działa tylko na serwerach z mniej niż 25 członkami
# i tylko dla zespołu aplikacji oraz testerów; poza tym zostaje link do strony w przeglądarce (działa bez limitu).
ACTIVITY=0
# 1 = okno przydziału pokazuje wszystkich, którzy widzą forum, a nie tylko osoby znane botowi z ostatnich akcji.
# Wymaga włączenia "Server Members Intent" w Developer Portal (Bot -> Privileged Gateway Intents).
MEMBERS_INTENT=0

# Tylko przy przenosinach na inny hosting (np. Railway): zawartość pliku state.json zakodowana w base64, w jednej linii.
# Bot użyje jej wyłącznie wtedy, gdy pliku stanu jeszcze nie ma, więc po pierwszym starcie możesz usunąć tę zmienną. README, rozdział "Railway".
#STATE_SEED_B64=

# Token tunelu Cloudflare (panel Cloudflare -> Networking -> Tunnels -> Twój tunel -> polecenie instalacyjne -> wartość po "--token").
# Używany tylko po: docker compose --profile tunnel up -d
#TUNNEL_TOKEN=
